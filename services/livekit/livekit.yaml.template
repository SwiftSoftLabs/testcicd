port: 7880
log_level: info

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true

redis:
  address: 127.0.0.1:6379
  password: ${REDIS_PASSWORD}

turn:
  enabled: true
  domain: ${LIVEKIT_TURN_DOMAIN}
  cert_file: /turn.crt
  key_file: /turn.key
  # UDP TURN (open UDP 3478 on firewall). TLS TURN on 443 is handled by Caddy for signaling;
  # do not set tls_port: 443 here while Caddy binds 443.
  udp_port: 3478

key_file: /keys.yaml

room:
  auto_create: true
  empty_timeout: 300
  max_participants: 50
