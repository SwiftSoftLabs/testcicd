LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=onework-meeting-assistant

# Vercel app URL for Gemini webhook (POST /api/calls/{id}/ai/llm)
NEXT_PUBLIC_APP_URL=http://localhost:3000
CALL_AI_LLM_WEBHOOK_SECRET=dev-local-llm-webhook-secret

# --- Speech-to-text (faster-whisper) ---
# Accuracy tiers (slowest → fastest):
#   large-v3        — best quality, needs strong CPU or CUDA
#   distil-large-v3 — default; strong quality on dev laptops
#   medium.en       — English-only, lighter
#   base.en         — fast but inaccurate (not recommended)
WHISPER_MODEL_SIZE=distil-large-v3
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
# cpu default on x86: int8_float16; cuda: float16
# WHISPER_COMPUTE_TYPE=int8_float16
# 2 GB VPS: use small.en + int8 (no inline comments on the same line)
# WHISPER_MODEL_SIZE=small.en
# WHISPER_COMPUTE_TYPE=int8

# Seconds for LiveKit to wait while prewarm loads Whisper (default in agent.py: 180)
# AGENT_INITIALIZE_PROCESS_TIMEOUT=180
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_INITIAL_PROMPT=OneWork video meeting. Participants discuss projects, tasks, deadlines, action items, pull requests, and workspace updates.

# Silero VAD (seconds) — lower min_silence = snappier captions
SILERO_MIN_SILENCE_DURATION=0.45
SILERO_PREFIX_PADDING_DURATION=0.35
SILERO_ACTIVATION_THRESHOLD=0.45

# Spoken voice-assistant replies (off by default — captions-only STT works without this)
# CALL_AI_VOICE_ASSISTANT=true

# Piper HTTP server (optional — voice replies only)
PIPER_BASE_URL=http://127.0.0.1:5000

# --- Optional Krisp VIVA server-side NC (Hetzner / on-prem) ---
# Requires: pip install livekit-plugins-krisp + krisp-audio wheel from https://krisp.ai/developers/
# Improves STT/captions under noise; does NOT denoise audio for other human participants.
# KRISP_VIVA_ENABLED=false
# KRISP_VIVA_SDK_LICENSE_KEY=
# KRISP_VIVA_FILTER_MODEL_PATH=/opt/krisp/models/krisp-viva-tel-v2.kef
# KRISP_VIVA_NOISE_SUPPRESSION_LEVEL=100
